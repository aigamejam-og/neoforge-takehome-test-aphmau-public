{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "containerEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ]
    }
  },

  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && npm cache clean --force && sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/*"
}
